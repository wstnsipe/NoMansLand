root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Enfusion: Allman braces, tab indentation (BI Scripting Conventions)
[*.{c,et,ent,layer,conf,layout,st,meta,emat,gproj}]
indent_style = tab
indent_size = 4
end_of_line = crlf

[*.{mjs,js,ps1}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
