# Normalize line endings in the repo; check out native endings.
* text=auto

# Enfusion text formats (committed as text, mergeable, .meta always included)
*.c        text diff=cpp
*.gproj    text
*.et       text
*.ent      text
*.layer    text
*.conf     text
*.layout   text
*.st       text
*.meta     text
*.emat     text
*.ct       text

# Scripts
*.ps1      text eol=crlf
*.sh       text eol=lf
tools/githooks/* text eol=lf

# Binary assets: Git LFS, lockable (edit under `git lfs lock`).
# Keep in sync with LFS_EXT in tools/validate.mjs.
*.xob   filter=lfs diff=lfs merge=lfs -text lockable
*.fbx   filter=lfs diff=lfs merge=lfs -text lockable
*.edds  filter=lfs diff=lfs merge=lfs -text lockable
*.dds   filter=lfs diff=lfs merge=lfs -text lockable
*.tif   filter=lfs diff=lfs merge=lfs -text lockable
*.tiff  filter=lfs diff=lfs merge=lfs -text lockable
*.tga   filter=lfs diff=lfs merge=lfs -text lockable
*.png   filter=lfs diff=lfs merge=lfs -text lockable
*.jpg   filter=lfs diff=lfs merge=lfs -text lockable
*.jpeg  filter=lfs diff=lfs merge=lfs -text lockable
*.psd   filter=lfs diff=lfs merge=lfs -text lockable
*.wav   filter=lfs diff=lfs merge=lfs -text lockable
*.ogg   filter=lfs diff=lfs merge=lfs -text lockable
*.anm   filter=lfs diff=lfs merge=lfs -text lockable
